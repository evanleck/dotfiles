[user]
name = Evan Lecklider
email = evan@lecklider.com

[core]
autocrlf = false
excludesfile = ~/.config/git/ignore
pager = delta
quotepath = false

[alias]
b = branch
co = checkout
d = diff
ds = diff --staged
ls = log --pretty=oneline --abbrev-commit --graph --decorate
recent = log -10 --graph --pretty=oneline --abbrev-commit --date=relative
s = status -sb
today = log --since='1 day ago' --graph --pretty=oneline --abbrev-commit --date=relative
twoweeks = log --since='14 days ago' --graph --pretty=oneline --abbrev-commit --date=relative
wc = whatchanged -p
week = log --since='7 days ago' --graph --pretty=oneline --abbrev-commit --date=relative

[interactive]
diffFilter = delta --color-only

[add.interactive]
useBuiltin = false

[delta]
# syntax-theme = Catppuccin Mocha
syntax-theme = Rose-Pine
tabs = 2

[delta "rose-pine"]
dark = true
syntax-theme = Rose-Pine
line-numbers = true
side-by-side = false
file-style = brightwhite
file-decoration-style = none
file-added-label = [+]
file-copied-label = [==]
file-modified-label = [*]
file-removed-label = [-]
file-renamed-label = [->]
hunk-header-decoration-style = "#3e3e43" box ul
plus-style = syntax auto
plus-emph-style = syntax auto
minus-style = syntax auto
minus-emph-style = syntax auto
line-numbers-minus-style = "#eb6f92"
line-numbers-plus-style = "#9ccfd8"
tabs = 2

[mergetool]
keepBackup = true
prompt = false

[init]
defaultBranch = main

[commit]
verbose = true

[diff]
algorithm = histogram

[status]
showUntrackedFiles = all

[push]
default = simple
followTags = true

[pull]
ff = only

[fetch]
prune = true

[merge]
conflictstyle = zdiff3

[filter "media"]
clean = git media clean %f
required = true
smudge = git media smudge %f

[filter "lfs"]
clean = git-lfs clean -- %f
process = git-lfs filter-process
required = true
smudge = git-lfs smudge -- %f
